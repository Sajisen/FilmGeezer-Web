{
    admin off
    persist_config off
    auto_https off

    # Keep Caddy's own low-volume runtime logs structured for Railway.
    # Do not enable the site-level `log` directive below: Railway already
    # provides native HTTP request logs, so duplicating every static request
    # into application stdout would add noise without useful new information.
    log {
        format json
    }

    servers {
        trusted_proxies static private_ranges 100.0.0.0/8
    }
}

:{$PORT:3000} {
    @health path /health
    respond @health "ok" 200

    root * dist
    encode gzip

    @immutableAssets {
        path /assets/* /filmgeezer-logo-v1.webp /filmgeezer-icon-64.png /filmgeezer-icon-180.png
    }
    header @immutableAssets Cache-Control "public, max-age=31536000, immutable"

    @application {
        not path /assets/* /filmgeezer-logo-v1.webp /filmgeezer-icon-64.png /filmgeezer-icon-180.png
    }
    header @application Cache-Control "no-cache"

    # The same Railway frontend service also serves admin.filmgeezer.site.
    # Search-engine controls are not a security boundary, but the admin
    # application should never be intentionally indexed.
    @adminHost host admin.filmgeezer.site
    header @adminHost X-Robots-Tag "noindex, nofollow"

    # These routes are user-specific, authentication-related, generated search
    # results, or development utilities rather than useful public landing pages.
    @nonIndexableRoutes path /search* /watchlist* /account* /notifications* /login* /register* /registration-pending* /verify-email* /forgot-password* /reset-password* /api-test*
    header @nonIndexableRoutes X-Robots-Tag "noindex, nofollow"

    header {
        -Server
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        X-Frame-Options "DENY"
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    try_files {path} /index.html
    file_server
}
