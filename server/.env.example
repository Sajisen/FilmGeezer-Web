# FilmGeezer server environment example
# Copy to server/.env for local development only. Never commit real secrets.

NODE_ENV=development
PORT=5000
HOST=0.0.0.0

# Application logging.
# Local development defaults to readable one-line logs and mutation/error-focused
# access logging. Production defaults to JSON logs for Railway ingestion.
# Temporarily set HTTP_ACCESS_LOG_MODE=all only when debugging individual requests.
LOG_LEVEL=debug
LOG_FORMAT=pretty
HTTP_ACCESS_LOG_MODE=mutations

CLIENT_APP_ORIGIN=http://localhost:5173
ADMIN_APP_ORIGIN=http://localhost:5173

TMDB_READ_ACCESS_TOKEN=replace-with-tmdb-read-access-token

MONGODB_URI=mongodb+srv://replace-with-your-mongodb-uri
MONGODB_CONTENT_DB_NAME=filmgeezer_bot
MONGODB_CONTENT_LINKS_COLLECTION=content_links
MONGODB_WEB_DB_NAME=filmgeezer_web

AUTH_CHALLENGE_PEPPER=replace-with-at-least-32-random-characters
AUTH_SESSION_PEPPER=replace-with-at-least-32-random-characters

ADMIN_MFA_REQUIRED=false
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_MFA_RECOVERY_PEPPER=

ADMIN_WEBAUTHN_RP_NAME=FilmGeezer Administration
ADMIN_WEBAUTHN_RP_ID=localhost
ADMIN_WEBAUTHN_ORIGIN=http://localhost:5173

# Production transactional email (Resend).
# The webhook secret is added only after the Resend webhook endpoint is created.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=no-reply@notifications.filmgeezer.site
RESEND_REPLY_TO_EMAIL=support@filmgeezer.site

# Local development profile-image storage.
PROFILE_IMAGE_STORAGE_DRIVER=local
PROFILE_IMAGE_LOCAL_DIRECTORY=.data/profile-images

# Production Railway Bucket values. Prefer Railway reference variables rather
# than copying Bucket secrets into source-controlled files.
PROFILE_IMAGE_BUCKET_NAME=
PROFILE_IMAGE_BUCKET_ENDPOINT=
PROFILE_IMAGE_BUCKET_REGION=
PROFILE_IMAGE_BUCKET_ACCESS_KEY_ID=
PROFILE_IMAGE_BUCKET_SECRET_ACCESS_KEY=
PROFILE_IMAGE_BUCKET_FORCE_PATH_STYLE=false